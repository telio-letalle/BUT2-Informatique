<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="447.0" prefWidth="581.0" spacing="20.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.umontpellier.iut.tpjdbc.ControleurFenetre">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox alignment="CENTER" prefHeight="92.0" prefWidth="530.0" spacing="10.0" style="-fx-background-color: lightgrey;" VBox.vgrow="ALWAYS">
      <children>
         <Label fx:id="labRecherche" text="Personnes agées de plus de" />
         <TextField fx:id="txtAgeMinimum" />
         <Button fx:id="btRechercher" mnemonicParsing="false" onAction="#btRechercherClicked" text="Rechercher" />
         <Button fx:id="btTous" mnemonicParsing="false" onAction="#btTousClicked" text="Tous" />
      </children>
   </HBox>
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
      <children>
         <VBox prefHeight="170.0" prefWidth="146.0" spacing="20.0">
            <children>
            
                     <Label fx:id="labNum" text="Code personne" />
               <Label fx:id="labNom" text="Nom personne" />
               <Label fx:id="labPrenom" prefHeight="18.0" prefWidth="110.0" text="Prenom personne" />
               <Label fx:id="labNationalite" text="Nationalité personne" />
               <Label fx:id="labAge" text="Age personne" />
            </children>
         </VBox>
         <VBox prefHeight="170.0" prefWidth="210.0" spacing="10.0">
            <children>
               <TextField fx:id="txtNum" />
               <TextField fx:id="txtNom" />
               <TextField fx:id="txtPrenom" />
               <TextField fx:id="txtNationalite" />
               <TextField fx:id="txtAge" />
            </children>
         </VBox>
      </children>
   </HBox>
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="481.0" spacing="10.0">
      <children>
          <Button fx:id="btPremier" onAction="#btPremierClicked" text="|&lt;" />
         <Button fx:id="btPrecedent" mnemonicParsing="false" onAction="#btPrecedentClicked" text="&lt;" />
         <Button fx:id="btSuivant" mnemonicParsing="false" onAction="#btSuivantClicked" text="&gt;" />
         <Button fx:id="btDernier" mnemonicParsing="false" onAction="#btDernierClicked" text="&gt;|" />
      </children>
   </HBox>
   <HBox alignment="CENTER" prefHeight="94.0" prefWidth="521.0" spacing="10.0" style="-fx-background-color: lightgrey;">
      <children>
         <Button fx:id="btVider" mnemonicParsing="false" onAction="#btViderClicked" text="Vider formulaire" />
         <Button fx:id="btEnregistrer" mnemonicParsing="false" onAction="#btEnregistrerClicked" text="Enregistrer nouveau" />
         <Button fx:id="btModifier" mnemonicParsing="false" onAction="#btModifierClicked" text="Modifier" />
         <Button fx:id="btSupprimer" mnemonicParsing="false" onAction="#btSupprimerClicked" text="Supprimer" />
      </children>
   </HBox>
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
      <children>
         <Label fx:id="labNationalites" text="Nationalités" />
         <ComboBox fx:id="cbNationalites" onShown="#cbNationalitesShown" prefWidth="150.0" />
         <Button fx:id="btMoyenneAge" mnemonicParsing="false" onAction="#btMoyenneAgeClicked" text="Moyenne d'âge" />
      </children>
   </HBox>
</VBox>
